# Mật khẩu mặc định cho môi trường demo: chỉ cần chạy  Copy-Item .env.example .env
# Khi triển khai thật phải đổi toàn bộ mật khẩu và SESSION_SECRET.

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=Root@2026
# Giữ nguyên 2 tên dưới: các script khởi tạo trong database/ dùng đúng các tên này
MYSQL_DATABASE=ecommerce_db
MYSQL_USER=ecommerce_app
MYSQL_PASSWORD=App@2026
# Tài khoản chỉ đọc báo cáo (report_user) dùng trong phpMyAdmin
MYSQL_REPORT_PASSWORD=Report@2026

# ---------- Backend ----------
# Khóa ký cookie đăng nhập, >= 32 ký tự
SESSION_SECRET=TechZone-Demo-Session-Secret-2026-Change-Me
# Tài khoản admin website, tự tạo khi backend khởi động lần đầu
# Mật khẩu 8-72 ký tự, có chữ hoa, chữ thường và chữ số
ADMIN_EMAIL=admin@techzone.local
ADMIN_PASSWORD=Admin@2026
